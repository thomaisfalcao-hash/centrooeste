<!DOCTYPE html>
<html lang="pt-BR">
<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>Apresentação Centro-Oeste</title>


<style>

/* =====================================================
   CONFIGURAÇÃO GERAL
   ===================================================== */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: #000;
    color: #fff;

    font-family:
        'Segoe UI',
        Roboto,
        Helvetica,
        Arial,
        sans-serif;

    overflow: hidden;

    width: 100vw;
    height: 100vh;
}


/* =====================================================
   APLICATIVO
   ===================================================== */

#app {
    width: 100%;
    height: 100%;

    position: relative;
}


#slide-container {
    width: 100%;
    height: 100%;

    display: flex;

    align-items: center;
    justify-content: center;

    background: #000;

    perspective: 1200px;
}


/* =====================================================
   SLIDES DE MÍDIA
   ===================================================== */

.media-slide {

    width: 100vw;
    height: 100vh;

    object-fit: contain;

    display: none;
}


.media-slide.active {
    display: block;
}


/* =====================================================
   ÁUDIO DE FUNDO
   ===================================================== */

#audio-fundo {

    position: fixed;

    width: 1px;
    height: 1px;

    left: -10px;
    top: -10px;

    opacity: 0;

    pointer-events: none;

    z-index: -1;
}


/* =====================================================
   ÁUDIO DA MÚSICA
   ===================================================== */

#audio-musica {

    position: fixed;

    width: 1px;
    height: 1px;

    left: -10px;
    top: -10px;

    opacity: 0;

    pointer-events: none;

    z-index: -1;
}


/* =====================================================
   ATIVIDADES
   ===================================================== */

.atividade-slide,
.encerramento-slide {

    display: none;

    width: 100%;
    height: 100%;

    background:
        linear-gradient(
            135deg,
            #1565C0,
            #2E7D32
        );

    flex-direction: column;

    align-items: center;
    justify-content: center;

    padding: 40px;

    text-align: center;
}


.atividade-slide.active,
.encerramento-slide.active {

    display: flex;
}


/* =====================================================
   TÍTULO DAS ATIVIDADES
   ===================================================== */

.titulo-atividade {

    font-size: 38px;

    font-weight: bold;

    margin-bottom: 30px;

    color: #FBC02D;

    text-shadow:
        2px 2px 4px rgba(0,0,0,0.5);
}


/* =====================================================
   BOTÕES
   ===================================================== */

.btn-opcao {

    background: #fff;

    color: #333;

    border: none;

    padding: 15px 35px;

    margin: 10px;

    font-size: 22px;

    border-radius: 10px;

    cursor: pointer;

    font-weight: bold;

    box-shadow:
        0 4px 6px rgba(0,0,0,0.3);

    transition: 0.2s;
}


.btn-opcao:hover {

    background: #FBC02D;

    transform: scale(1.05);
}


.input-atividade {

    padding: 15px;

    font-size: 22px;

    border-radius: 8px;

    border: none;

    width: 50%;

    max-width: 450px;

    margin-bottom: 20px;

    text-align: center;

    color: #333;
}


.btn-confirmar {

    background: #FBC02D;

    color: #000;

    border: none;

    padding: 15px 35px;

    font-size: 22px;

    font-weight: bold;

    border-radius: 8px;

    cursor: pointer;

    transition: 0.2s;
}


.btn-confirmar:hover {

    background: #ffca28;

    transform: scale(1.05);
}


/* =====================================================
   ATIVIDADE DE LIGAR
   ===================================================== */

.grid-ligar {

    display: flex;

    gap: 40px;

    margin-bottom: 25px;
}


.item-ligar {

    background:
        rgba(255,255,255,0.1);

    padding: 20px;

    border-radius: 10px;

    font-size: 20px;
}


.item-ligar select {

    padding: 10px;

    font-size: 18px;

    margin-top: 10px;

    border-radius: 5px;

    color: #333;
}


/* =====================================================
   FEEDBACK
   ===================================================== */

.feedback {

    margin-top: 20px;

    font-size: 26px;

    font-weight: bold;

    min-height: 40px;
}


.correto {
    color: #00FF00;
}


.errado {
    color: #FF5555;
}


/* =====================================================
   INDICADOR
   ===================================================== */

#indicador-progresso {

    position: absolute;

    bottom: 20px;
    left: 50%;

    transform: translateX(-50%);

    background:
        rgba(0,0,0,0.7);

    padding: 8px 20px;

    border-radius: 20px;

    font-weight: bold;

    font-size: 16px;

    letter-spacing: 1px;

    z-index: 1000;

    backdrop-filter: blur(5px);
}


/* =====================================================
   BOTÃO DE ÁUDIO
   ===================================================== */

#btn-iniciar-audio {

    position: absolute;

    top: 20px;
    right: 20px;

    background: #FBC02D;

    color: #000;

    border: none;

    padding: 12px 20px;

    border-radius: 8px;

    font-weight: bold;

    font-size: 16px;

    cursor: pointer;

    z-index: 1000;

    box-shadow:
        0 4px 6px rgba(0,0,0,0.5);

    transition: 0.2s;
}


#btn-iniciar-audio:hover {

    transform: scale(1.05);
}


/* =====================================================
   ANIMAÇÕES
   ===================================================== */

.media-slide.active,
.atividade-slide.active,
.encerramento-slide.active {

    animation-duration: 0.8s;

    animation-fill-mode: both;

    animation-timing-function:
        cubic-bezier(.2,.8,.2,1);
}


/* 1 - Fade */

#slide-0.active {
    animation-name: fadeIn;
}


/* 2 - Zoom */

#slide-1.active {
    animation-name: zoomIn;
}


/* 3 - Esquerda */

#slide-2.active {
    animation-name: fromLeft;
}


/* 4 - Direita */

#slide-3.active {
    animation-name: fromRight;
}


/* 5 - Cima */

#slide-4.active {
    animation-name: fromTop;
}


/* 6 - Baixo */

#slide-5.active {
    animation-name: fromBottom;
}


/* 7 - Zoom pequeno */

#slide-6.active {
    animation-name: smallZoom;
}


/* 8 - Esquerda + zoom */

#slide-7.active {
    animation-name: leftZoom;
}


/* 9 - Direita + zoom */

#slide-8.active {
    animation-name: rightZoom;
}


/* 10 - Cima + zoom */

#slide-9.active {
    animation-name: topZoom;
}


/* 11 - Rotação */

#slide-10.active {
    animation-name: rotateIn;
}


/* 12 - Fade + zoom */

#slide-11.active {
    animation-name: fadeZoom;
}


/* 13 - Entrada rápida direita */

#slide-12.active {
    animation-name: fastRight;
}


/* 14 - Entrada rápida esquerda */

#slide-13.active {
    animation-name: fastLeft;
}


/* 15 - Zoom forte */

#slide-14.active {
    animation-name: bigZoom;
}


/* 16 - Baixo + zoom */

#slide-15.active {
    animation-name: bottomZoom;
}


/* 17 - Cima + zoom */

#slide-16.active {
    animation-name: topZoom2;
}


/* 18 - Cortina */

#slide-17.active {
    animation-name: curtain;
}


/* 19 - Giro 3D */

#slide-18.active {
    animation-name: spin3D;
}


/* 20 - Desfoque */

#slide-19.active {
    animation-name: blurIn;
}


/* 21 - Música */

#slide-20.active {
    animation-name: musicIn;
}


/* 22 - Suave */

#slide-21.active {
    animation-name: softZoom;
}


/* 23 - Subindo */

#slide-22.active {
    animation-name: riseUp;
}


/* 24 - Final */

#slide-23.active {
    animation-name: finalIn;
}


/* =====================================================
   KEYFRAMES
   ===================================================== */

@keyframes fadeIn {

    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}


@keyframes zoomIn {

    from {
        opacity: 0;
        transform: scale(1.3);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }
}


@keyframes fromLeft {

    from {
        opacity: 0;
        transform: translateX(-100%);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }
}


@keyframes fromRight {

    from {
        opacity: 0;
        transform: translateX(100%);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }
}


@keyframes fromTop {

    from {
        opacity: 0;
        transform: translateY(-100%);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}


@keyframes fromBottom {

    from {
        opacity: 0;
        transform: translateY(100%);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}


@keyframes smallZoom {

    from {
        opacity: 0;
        transform: scale(0.7);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }
}


@keyframes leftZoom {

    from {
        opacity: 0;
        transform:
            translateX(-80px)
            scale(1.15);
    }

    to {
        opacity: 1;
        transform:
            translateX(0)
            scale(1);
    }
}


@keyframes rightZoom {

    from {
        opacity: 0;
        transform:
            translateX(80px)
            scale(1.15);
    }

    to {
        opacity: 1;
        transform:
            translateX(0)
            scale(1);
    }
}


@keyframes topZoom {

    from {
        opacity: 0;
        transform:
            translateY(-80px)
            scale(1.15);
    }

    to {
        opacity: 1;
        transform:
            translateY(0)
            scale(1);
    }
}


@keyframes rotateIn {

    from {
        opacity: 0;
        transform:
            rotate(-12deg)
            scale(0.8);
    }

    to {
        opacity: 1;
        transform:
            rotate(0)
            scale(1);
    }
}


@keyframes fadeZoom {

    from {
        opacity: 0;
        transform: scale(0.85);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }
}


@keyframes fastRight {

    from {
        opacity: 0;
        transform: translateX(120%);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }
}


@keyframes fastLeft {

    from {
        opacity: 0;
        transform: translateX(-120%);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }
}


@keyframes bigZoom {

    from {
        opacity: 0;
        transform: scale(1.5);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }
}


@keyframes bottomZoom {

    from {
        opacity: 0;
        transform:
            translateY(100px)
            scale(0.9);
    }

    to {
        opacity: 1;
        transform:
            translateY(0)
            scale(1);
    }
}


@keyframes topZoom2 {

    from {
        opacity: 0;
        transform:
            translateY(-100px)
            scale(0.9);
    }

    to {
        opacity: 1;
        transform:
            translateY(0)
            scale(1);
    }
}


@keyframes curtain {

    from {
        opacity: 0;
        clip-path:
            inset(0 100% 0 0);
    }

    to {
        opacity: 1;
        clip-path:
            inset(0 0 0 0);
    }
}


@keyframes spin3D {

    from {
        opacity: 0;

        transform:
            rotateY(90deg)
            scale(0.8);
    }

    to {
        opacity: 1;

        transform:
            rotateY(0)
            scale(1);
    }
}


@keyframes blurIn {

    from {
        opacity: 0;

        filter: blur(15px);

        transform: scale(1.08);
    }

    to {
        opacity: 1;

        filter: blur(0);

        transform: scale(1);
    }
}


@keyframes musicIn {

    from {
        opacity: 0;

        transform:
            scale(0.6)
            rotate(-5deg);
    }

    to {
        opacity: 1;

        transform:
            scale(1)
            rotate(0);
    }
}


@keyframes softZoom {

    from {
        opacity: 0;

        transform: scale(0.92);
    }

    to {
        opacity: 1;

        transform: scale(1);
    }
}


@keyframes riseUp {

    from {
        opacity: 0;

        transform:
            translateY(150px);
    }

    to {
        opacity: 1;

        transform:
            translateY(0);
    }
}


@keyframes finalIn {

    from {
        opacity: 0;

        transform:
            scale(0.5);
    }

    70% {
        opacity: 1;

        transform:
            scale(1.05);
    }

    to {
        opacity: 1;

        transform:
            scale(1);
    }
}

</style>

</head>


<body>


<div id="app">


<!-- =====================================================
     ÁUDIO DE FUNDO
     ===================================================== -->

<video
    id="audio-fundo"
    src="audio-fundo.mp4"
    loop
    playsinline
    preload="auto">
</video>


<!-- =====================================================
     MÚSICA
     ===================================================== -->

<video
    id="audio-musica"
    src="musica.mp4"
    loop
    playsinline
    preload="auto">
</video>


<!-- =====================================================
     BOTÃO
     ===================================================== -->

<button id="btn-iniciar-audio">

    🎵 Iniciar Áudio

</button>


<!-- =====================================================
     SLIDES
     ===================================================== -->

<div id="slide-container"></div>


<!-- =====================================================
     CONTADOR
     ===================================================== -->

<div id="indicador-progresso">

    Slide 1/24

</div>


</div>



<script>


/* =====================================================
   SLIDES
   ===================================================== */

const slides = [

    {
        tipo: 'video',
        src: 'intro1.mp4'
    },

    {
        tipo: 'video',
        src: 'intro2.mp4'
    },

    {
        tipo: 'imagem',
        src: 'clima1.jpeg'
    },

    {
        tipo: 'imagem',
        src: 'relevo1.jpeg'
    },

    {
        tipo: 'imagem',
        src: 'hidrografia1.jpeg'
    },

    {
        tipo: 'atividade1'
    },

    {
        tipo: 'imagem',
        src: 'aspectos_geograficos1.jpeg'
    },

    {
        tipo: 'imagem',
        src: 'populacao1.jpeg'
    },

    {
        tipo: 'imagem',
        src: 'natalidade1.jpeg'
    },

    {
        tipo: 'imagem',
        src: 'crescimento_vegetativo1.jpeg'
    },

    {
        tipo: 'atividade2'
    },

    {
        tipo: 'imagem',
        src: 'idh1.jpeg'
    },

    {
        tipo: 'video',
        src: 'sotaque.mp4'
    },

    {
        tipo: 'imagem',
        src: 'jk.jpeg'
    },

    {
        tipo: 'imagem',
        src: 'culinaria1.jpeg'
    },

    {
        tipo: 'imagem',
        src: 'culinaria2.jpeg'
    },

    {
        tipo: 'imagem',
        src: 'culinaria3.jpeg'
    },

    {
        tipo: 'imagem',
        src: 'culinaria4.jpeg'
    },

    {
        tipo: 'atividade3'
    },

    {
        tipo: 'video',
        src: 'danca.mp4'
    },

    /* =================================
       SLIDE DA MÚSICA
       IMAGEM NA TELA
       MP4 APENAS COMO ÁUDIO
       ================================= */

    {
        tipo: 'musica',
        src: 'musica1.jpeg'
    },

    {
        tipo: 'imagem',
        src: 'religiao1.jpeg'
    },

    {
        tipo: 'atividade4'
    },

    {
        tipo: 'encerramento'
    }

];



/* =====================================================
   VARIÁVEIS
   ===================================================== */

let slideAtual = 0;

let audioIniciado = false;


const container =
    document.getElementById(
        'slide-container'
    );


const indicadorProgresso =
    document.getElementById(
        'indicador-progresso'
    );


const audioFundo =
    document.getElementById(
        'audio-fundo'
    );


const audioMusica =
    document.getElementById(
        'audio-musica'
    );



/* =====================================================
   BOTÃO DE ÁUDIO
   ===================================================== */

document
    .getElementById(
        'btn-iniciar-audio'
    )
    .addEventListener(
        'click',
        function() {

            audioIniciado = true;


            audioFundo.muted = false;

            audioFundo.volume = 0.4;


            audioMusica.muted = false;

            audioMusica.volume = 0.7;


            atualizarTela();


            document
                .getElementById(
                    'btn-iniciar-audio'
                )
                .style.display =
                'none';

        }
    );



/* =====================================================
   RENDERIZAÇÃO
   ===================================================== */

function renderizarSlides() {

    container.innerHTML = '';


    slides.forEach(
        function(slide, index) {

            let elemento;


            /* =========================
               IMAGEM
               ========================= */

            if (
                slide.tipo === 'imagem'
            ) {

                elemento =
                    document.createElement(
                        'img'
                    );


                elemento.src =
                    slide.src;


                elemento.alt =
                    `Slide ${index + 1}`;


                elemento.className =
                    'media-slide';

            }


            /* =========================
               VÍDEO
               ========================= */

            else if (
                slide.tipo === 'video'
            ) {

                elemento =
                    document.createElement(
                        'video'
                    );


                elemento.src =
                    slide.src;


                elemento.className =
                    'media-slide';


                elemento.controls = true;

                elemento.playsInline = true;

                elemento.volume = 1;

            }


            /* =========================
               MÚSICA
               IMAGEM NA TELA
               ========================= */

            else if (
                slide.tipo === 'musica'
            ) {

                elemento =
                    document.createElement(
                        'img'
                    );


                elemento.src =
                    slide.src;


                elemento.alt =
                    'Imagem da música';


                elemento.className =
                    'media-slide';

            }


            /* =========================
               ATIVIDADE 1
               ========================= */

            else if (
                slide.tipo === 'atividade1'
            ) {

                elemento =
                    document.createElement(
                        'div'
                    );


                elemento.className =
                    'atividade-slide';


                elemento.innerHTML = `

                    <div class="titulo-atividade">

                        🎯 Qual é o bioma predominante
                        no Centro-Oeste?

                    </div>


                    <div>

                        <button
                            class="btn-opcao"
                            onclick="verificarA1(false)">

                            Amazônia

                        </button>


                        <button
                            class="btn-opcao"
                            onclick="verificarA1(true)">

                            Cerrado

                        </button>


                        <button
                            class="btn-opcao"
                            onclick="verificarA1(false)">

                            Caatinga

                        </button>

                    </div>


                    <div
                        id="fb-a1"
                        class="feedback">
                    </div>

                `;

            }


            /* =========================
               ATIVIDADE 2
               ========================= */

            else if (
                slide.tipo === 'atividade2'
            ) {

                elemento =
                    document.createElement(
                        'div'
                    );


                elemento.className =
                    'atividade-slide';


                elemento.innerHTML = `

                    <div class="titulo-atividade">

                        ✍️ Qual é a capital do Brasil,
                        localizada no Centro-Oeste?

                    </div>


                    <input
                        type="text"
                        id="input-a2"
                        class="input-atividade"
                        placeholder="Digite aqui..."
                    >


                    <br>


                    <button
                        class="btn-confirmar"
                        onclick="verificarA2()">

                        Confirmar

                    </button>


                    <div
                        id="fb-a2"
                        class="feedback">
                    </div>

                `;

            }


            /* =========================
               ATIVIDADE 3
               ========================= */

            else if (
                slide.tipo === 'atividade3'
            ) {

                elemento =
                    document.createElement(
                        'div'
                    );


                elemento.className =
                    'atividade-slide';


                elemento.innerHTML = `

                    <div class="titulo-atividade">

                        🔗 Relacione os pratos típicos:

                    </div>


                    <div class="grid-ligar">


                        <div class="item-ligar">

                            <b>
                                Arroz com Pequi
                            </b>

                            <br>


                            <select id="sel-pequi">

                                <option value="">
                                    Selecione...
                                </option>


                                <option value="certo">
                                    Típico de Goiás
                                </option>


                                <option value="errado">
                                    Típico do Sul
                                </option>

                            </select>

                        </div>


                        <div class="item-ligar">

                            <b>
                                Caldo de Piranha
                            </b>

                            <br>


                            <select id="sel-piranha">

                                <option value="">
                                    Selecione...
                                </option>


                                <option value="errado">
                                    Típico de Goiás
                                </option>


                                <option value="certo">
                                    Típico do Pantanal
                                </option>

                            </select>

                        </div>


                    </div>


                    <button
                        class="btn-confirmar"
                        onclick="verificarA3()">

                        Verificar

                    </button>


                    <div
                        id="fb-a3"
                        class="feedback">
                    </div>

                `;

            }


            /* =========================
               ATIVIDADE 4
               ========================= */

            else if (
                slide.tipo === 'atividade4'
            ) {

                elemento =
                    document.createElement(
                        'div'
                    );


                elemento.className =
                    'atividade-slide';


                elemento.innerHTML = `

                    <div class="titulo-atividade">

                        ✍️ Qual presidente construiu Brasília?

                    </div>


                    <input
                        type="text"
                        id="input-a4"
                        class="input-atividade"
                        placeholder="Nome do presidente..."
                    >


                    <br>


                    <button
                        class="btn-confirmar"
                        onclick="verificarA4()">

                        Confirmar

                    </button>


                    <div
                        id="fb-a4"
                        class="feedback">
                    </div>

                `;

            }


            /* =========================
               ENCERRAMENTO
               ========================= */

            else if (
                slide.tipo === 'encerramento'
            ) {

                elemento =
                    document.createElement(
                        'div'
                    );


                elemento.className =
                    'encerramento-slide';


                elemento.innerHTML = `

                    <h1
                        style="
                            font-size: 60px;
                            color: #FBC02D;
                        ">

                        Obrigado pela atenção!

                    </h1>


                    <p
                        style="
                            font-size: 26px;
                            margin-top: 20px;
                        ">

                        Trabalho sobre a
                        Região Centro-Oeste

                    </p>

                `;

            }


            elemento.id =
                `slide-${index}`;


            container.appendChild(
                elemento
            );

        }
    );


    atualizarTela();

}



/* =====================================================
   ATUALIZAÇÃO DA TELA
   ===================================================== */

function atualizarTela() {


    /* =================================
       PARA VÍDEOS NORMAIS
       ================================= */

    document
        .querySelectorAll(
            'video:not(#audio-fundo):not(#audio-musica)'
        )
        .forEach(
            function(video) {

                video.pause();

                video.currentTime = 0;

            }
        );


    /* =================================
       PARA ÁUDIO DA MÚSICA
       ================================= */

    audioMusica.pause();

    audioMusica.currentTime = 0;


    /* =================================
       SLIDE ATUAL
       ================================= */

    const atual =
        slides[slideAtual];


    /* =================================
       CONTROLE DOS ÁUDIOS
       ================================= */

    if (audioIniciado) {


        /* =============================
           MÚSICA
           ============================= */

        if (
            atual.tipo === 'musica'
        ) {

            audioFundo.pause();

            audioFundo.currentTime = 0;

            audioFundo.volume = 0;


            audioMusica.volume = 0.7;


            audioMusica
                .play()
                .catch(
                    function() {}
                );

        }


        /* =============================
           IMAGENS
           ============================= */

        else if (
            atual.tipo === 'imagem'
        ) {

            audioMusica.pause();

            audioMusica.currentTime = 0;


            audioFundo.volume = 0.4;


            audioFundo
                .play()
                .catch(
                    function() {}
                );

        }


        /* =============================
           OUTROS
           ============================= */

        else {

            audioFundo.pause();

            audioFundo.currentTime = 0;

            audioFundo.volume = 0;


            audioMusica.pause();

            audioMusica.currentTime = 0;

            audioMusica.volume = 0;

        }

    }


    /* =================================
       MOSTRA O SLIDE
       ================================= */

    for (
        let i = 0;
        i < slides.length;
        i++
    ) {

        const elemento =
            document.getElementById(
                `slide-${i}`
            );


        if (!elemento) {
            continue;
        }


        if (
            i === slideAtual
        ) {

            /*
             * Remove a classe primeiro
             * para reiniciar a animação.
             */

            elemento.classList.remove(
                'active'
            );


            void elemento.offsetWidth;


            elemento.classList.add(
                'active'
            );


            /* =========================
               VÍDEO
               ========================= */

            if (
                slides[i].tipo === 'video' &&
                elemento instanceof
                HTMLVideoElement
            ) {

                elemento.play()
                    .catch(
                        function() {}
                    );

            }

        }

        else {

            elemento.classList.remove(
                'active'
            );

        }

    }


    /* =================================
       CONTADOR
       ================================= */

    indicadorProgresso.innerText =
        `Slide ${slideAtual + 1}/${slides.length}`;

}



/* =====================================================
   PRÓXIMO
   ===================================================== */

function proximoSlide() {

    if (
        slideAtual <
        slides.length - 1
    ) {

        slideAtual++;

        atualizarTela();

    }

}



/* =====================================================
   ANTERIOR
   ===================================================== */

function slideAnterior() {

    if (
        slideAtual > 0
    ) {

        slideAtual--;

        atualizarTela();

    }

}



/* =====================================================
   TECLADO
   ===================================================== */

document.addEventListener(
    'keydown',
    function(e) {


        if (
            e.key === 'ArrowRight'
        ) {

            proximoSlide();

        }


        if (
            e.key === 'ArrowLeft'
        ) {

            slideAnterior();

        }


        /* =================================
           CTRL = PAUSAR/CONTINUAR ÁUDIO
           ================================= */

        if (
            e.key === 'Control' &&
            audioIniciado
        ) {


            if (
                slides[slideAtual].tipo ===
                'musica'
            ) {

                if (
                    audioMusica.paused
                ) {

                    audioMusica
                        .play()
                        .catch(
                            function() {}
                        );

                }

                else {

                    audioMusica.pause();

                }

            }


            else if (
                slides[slideAtual].tipo ===
                'imagem'
            ) {

                if (
                    audioFundo.paused
                ) {

                    audioFundo
                        .play()
                        .catch(
                            function() {}
                        );

                }

                else {

                    audioFundo.pause();

                }

            }

        }

    }
);



/* =====================================================
   FEEDBACK
   ===================================================== */

function mostrarFeedback(
    id = '',
    correto = false
) {

    const el =
        document.getElementById(id);


    if (!el) {
        return;
    }


    if (correto) {

        el.innerText =
            "✅ Correto!";

        el.className =
            "feedback correto";

    }

    else {

        el.innerText =
            "❌ Incorreto, tente novamente.";

        el.className =
            "feedback errado";

    }

}



